<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 12 split the old BLUETOOTH/BLUETOOTH_ADMIN pair into runtime
      permissions. Both sets are declared: the new ones for 31+, the legacy ones
      capped below it, or the app is refused on older devices for asking for
      permissions that do not exist there.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      BLUETOOTH_SCAN is deliberately absent. The app lists bonded devices only -
      it never runs discovery - and getBondedDevices() is gated on
      BLUETOOTH_CONNECT. Declaring SCAN bought no capability and cost the user a
      "find nearby devices" prompt.
    -->

    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Reconnect to the last socket after a restart. A phone that reboots
      overnight while charging would otherwise wake up unmanaged, and the user
      would not know until the battery had sat at 100% until morning.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Doze and the OEM task killers. A connectedDevice foreground service is
      mostly safe on stock Android, but skins that aggressively kill background
      apps will drop the link and the cutoff with it. Asked for once, and the
      user can refuse.

      Note this permission is restricted on Google Play; this app is sideloaded,
      which is the case it is allowed in.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 14 requires a foreground service to declare a type, and to hold the
      matching permission. connectedDevice is the honest one: the service exists
      to hold a Bluetooth link open while the app is not on screen.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Classic SPP, not BLE. An HC-05 is a Bluetooth 2.0 device. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:name=".SmartSocketApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSocket">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartSocket"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SocketService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          BOOT_COMPLETED is one of the few exemptions to Android 12's ban on
          starting a foreground service from the background, which is what makes
          reconnecting here legal at all.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Hands the exported history CSV to whatever app the user picks from the
          share sheet. Not exported and not permission-granting by itself: the
          receiving app gets read access to one file, for one share, because the
          intent carries FLAG_GRANT_READ_URI_PERMISSION.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
