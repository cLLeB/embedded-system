<Application x:Class="SmartSocket.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartSocket.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Gold on black, the same palette as the Android app. -->
        <SolidColorBrush x:Key="Ink" Color="#0A0A0A" />
        <SolidColorBrush x:Key="Panel" Color="#161616" />
        <SolidColorBrush x:Key="Gold" Color="#D4AF37" />
        <SolidColorBrush x:Key="Live" Color="#4CAF50" />
        <SolidColorBrush x:Key="Alarm" Color="#E53935" />
        <SolidColorBrush x:Key="Muted" Color="#8A8A8A" />
        <SolidColorBrush x:Key="Paper" Color="#F2F2F2" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Paper}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Paper}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="26" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Gold}" />
            <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#242424" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Paper}" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />

            <!-- Same treatment as the dashboard: still scrolls, no bar. -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

    </Application.Resources>
</Application>
