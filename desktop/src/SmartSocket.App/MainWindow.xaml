<Window x:Class="SmartSocket.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Socket"
        Height="700" Width="470"
        MinHeight="560" MinWidth="430"
        Background="{StaticResource Ink}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SMART SOCKET" Style="{StaticResource Heading}" />
            <TextBlock x:Name="LinkLine" Style="{StaticResource Caption}" Text="Not connected" />
        </StackPanel>

        <!-- ============ CONNECT ============ -->
        <Grid Grid.Row="1" x:Name="ConnectView">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Choose the socket" Foreground="{StaticResource Gold}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="The USB cable and a Classic HC-05 appear as COM ports. A Bluetooth LE module appears by name, marked (Bluetooth LE) — it never gets a COM port. Pair it in Windows Bluetooth settings first either way." />
                        <ListBox x:Name="PortList" Height="140" Margin="0,10,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Connect" Click="OnConnect" />
                            <Button Content="Refresh" Click="OnRefreshPorts" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="No hardware to hand?" Foreground="{StaticResource Gold}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Runs the socket's own state machine in software, so every screen works with nothing plugged in." />
                        <Button Content="Open demo" Click="OnDemo" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ConnectError" Foreground="{StaticResource Alarm}"
                           TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- ============ DASHBOARD ============ -->
        <Grid Grid.Row="1" x:Name="DashboardView" Visibility="Collapsed">
            <!--
              Hidden, not Disabled. Hidden keeps the wheel, the keyboard and
              touch working and only takes away the bar; Disabled would stop the
              content scrolling at all and cut off the buttons on a short window.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="StateLabel" Text="—" FontSize="22"
                                       Foreground="{StaticResource Gold}" FontWeight="SemiBold" />
                            <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CURRENT" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="CurrentReadout" Style="{StaticResource Readout}" Text="0.00 A" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            ToolTip="The highest current seen this charge. Blank unless a charge session is running.">
                                    <TextBlock Text="PEAK" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="PeakReadout" Text="—" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            ToolTip="What actually stops the charge. Your battery limit while the app is managing; the socket's own current threshold when it is not.">
                                    <TextBlock Text="CUTS AT" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="ThresholdReadout" Text="—" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RELAY" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="RelayReadout" Text="—" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="THIS LAPTOP" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="BatteryReadout" Style="{StaticResource Readout}" Text="—" />
                            <TextBlock x:Name="BatteryNote" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,4,0,10" />
                            <CheckBox x:Name="CutOnLimitBox" Foreground="{StaticResource Paper}"
                                      Content="Let the app manage charging" Margin="0,0,0,8"
                                      Checked="OnCutOnLimitChanged" Unchecked="OnCutOnLimitChanged" />
                            <TextBlock x:Name="LimitLabel" Style="{StaticResource Caption}" Text="Stop charging at 90%" />
                            <Slider x:Name="LimitSlider" Minimum="50" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                    ValueChanged="OnLimitChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SESSION" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <TextBlock x:Name="SessionReadout" FontFamily="Consolas" Text="—" />
                            <TextBlock x:Name="SavedReadout" FontFamily="Consolas" Text="—" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Cut power" Click="OnCut" />
                        <Button Content="Re-arm" Click="OnRearm" />
                        <Button Content="Probe" Click="OnProbe" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="History" Click="OnOpenHistory" />
                        <Button Content="Disconnect" Click="OnDisconnect" />
                    </WrapPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ HISTORY ============ -->
        <Grid Grid.Row="1" x:Name="HistoryView" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Charge history" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                           Text="Newest first. Export writes the same CSV the phone app does." />
                <ListBox x:Name="HistoryList" Height="380" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Export CSV" Click="OnExport" />
                    <Button Content="Clear" Click="OnClearHistory" />
                    <Button Content="Back" Click="OnCloseHistory" />
                </WrapPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Closing this window keeps the socket watched from the tray. Quit from the tray icon to stop." />
    </Grid>
</Window>
